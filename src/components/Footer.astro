---
// src/components/Footer.astro
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
const currentYear = new Date().getFullYear();

const quickLinks = [
  { name: "Inicio", href: "/" },
  { name: "Servicios", href: "#servicios" },
  { name: "Nosotros", href: "#nosotros" },
  { name: "Contacto", href: "#contacto" },
];

// Actualizamos el array para usar identificadores de iconos
const socialLinks = [
  { name: "Facebook", icon: "fb", href: "#" },
  { name: "LinkedIn", icon: "in", href: "#" },
  { name: "WhatsApp", icon: "wa", href: "https://wa.me/51999999999" },
];
---

<footer
  class="bg-gradient-to-br from-[#2499D6] to-[#1d82b8] text-white py-12 md:py-16 relative overflow-hidden"
>
  <div
    class="absolute top-0 left-0 w-48 h-48 md:w-64 md:h-64 bg-white/10 rounded-full -translate-x-1/2 -translate-y-1/2 blur-2xl pointer-events-none"
  >
  </div>
  <div
    class="absolute bottom-0 right-0 w-64 h-64 md:w-96 md:h-96 bg-blue-900/10 rounded-full translate-x-1/3 translate-y-1/3 blur-3xl pointer-events-none"
  >
  </div>

  <div class="container mx-auto px-5 md:px-12 relative z-10">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-x-8 gap-y-10 mb-12">
      <div class="col-span-2 md:col-span-1">
        <div class="flex items-center gap-3 mb-4 md:mb-6">
          <Image
            src={logo}
            alt="Logo"
            class="max-w-[160px] h-auto invert brightness-0"
          />
        </div>
        <p class="text-blue-50 text-sm leading-relaxed max-w-sm">
          Transformamos la gestión de tu negocio con tecnología simple, potente
          y a tu medida.
        </p>
      </div>

      <div class="col-span-1">
        <h4
          class="text-white font-bold mb-4 md:mb-6 text-base md:text-lg uppercase tracking-wider md:tracking-normal text-[10px] md:text-base opacity-80 md:opacity-100"
        >
          Navegación
        </h4>
        <ul class="space-y-3 text-sm">
          {
            quickLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-blue-100 hover:text-white hover:translate-x-1 transition-all inline-block py-1"
                >
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="col-span-1">
        <h4
          class="text-white font-bold mb-4 md:mb-6 text-base md:text-lg uppercase tracking-wider md:tracking-normal text-[10px] md:text-base opacity-80 md:opacity-100"
        >
          Servicios
        </h4>
        <ul class="space-y-3 text-sm">
          <li>
            <a
              href="#"
              class="text-blue-100 hover:text-white transition-colors py-1 block"
              >Software a Medida</a>
          </li>
          <li>
            <a
              href="#"
              class="text-blue-100 hover:text-white transition-colors py-1 block"
              >Gestión de Stock</a>
          </li>
          <li>
            <a
              href="#"
              class="text-blue-100 hover:text-white transition-colors py-1 block"
              >Apps Corporativas</a>
          </li>
        </ul>
      </div>

      <div
        class="col-span-2 md:col-span-1 pt-4 md:pt-0 border-t border-white/10 md:border-none"
      >
        <h4 class="text-white font-bold mb-4 md:mb-6 text-lg">Síguenos</h4>
        <div class="flex gap-4">
          {
            socialLinks.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="w-10 h-10 bg-white rounded-full flex items-center justify-center transition-all duration-300 group hover:bg-blue-900 hover:scale-110 shadow-md shadow-blue-900/20"
                aria-label={social.name}
              >
                {social.icon === "fb" && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-5 h-5 text-[#2499D6] group-hover:text-white transition-colors"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
                  </svg>
                )}
                {social.icon === "in" && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-5 h-5 text-[#2499D6] group-hover:text-white transition-colors"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 21.227.792 22 1.771 22h20.451C23.2 22 24 21.227 24 20.271V1.729C24 .774 23.2 0 22.225 0z" />
                  </svg>
                )}
                {social.icon === "wa" && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-5 h-5 text-[#2499D6] group-hover:text-white transition-colors"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.246 2.248 3.484 5.232 3.484 8.412-.003 6.557-5.338 11.892-11.893 11.892-1.997-.001-3.951-.5-5.688-1.448l-6.309 1.656zm6.224-3.92c1.516.903 3.109 1.38 4.75 1.382 5.352 0 9.706-4.354 9.708-9.707.001-2.593-1.011-5.031-2.85-6.87s-4.277-2.85-6.869-2.85c-5.351 0-9.707 4.354-9.709 9.707 0 1.8.473 3.558 1.37 5.111l-1.03 3.766 3.87-1.014z" />
                  </svg>
                )}
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div
      class="pt-8 border-t border-white/20 flex flex-col md:flex-row justify-between items-center gap-4 text-xs font-medium text-blue-100 text-center md:text-left"
    >
      <p>&copy; {currentYear} JKE Solutions. Todos los derechos reservados.</p>
      <div class="flex gap-6">
        <a href="#" class="hover:text-white transition-colors">Privacidad</a>
        <a href="#" class="hover:text-white transition-colors">Términos</a>
      </div>
    </div>
  </div>
</footer>
