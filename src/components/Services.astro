---
// src/components/Solutions.astro
const inventoryUrl = import.meta.env.INVENTORY_URL || "#";

const solutions = [
  {
    title: "Gestión de Inventarios",
    description:
      "Control analítico de stock para minimizar pérdidas y optimizar el reabastecimiento.",
    icon: "inventory",
    buttonText: "Ver Sistema",
    link: inventoryUrl,
  },
  {
    title: "Servicios Web",
    description:
      "Arquitectura web escalable y desarrollo de aplicaciones corporativas a medida.",
    icon: "web",
    buttonText: "Más Información",
    link: "#",
  },
  {
    title: "Consultorías IT",
    description:
      "Asesoramiento estratégico para modernizar su infraestructura digital.",
    icon: "consulting",
    buttonText: "Solicitar Consultoría",
    link: "#",
  },
];
---

<section id="servicios" class="py-16 md:py-24 bg-slate-50">
  <div class="container mx-auto px-5 md:px-12">
    <div class="text-center max-w-3xl mx-auto mb-10 md:mb-16">
      <h3
        class="text-[#2499D6] font-bold text-xs md:text-sm tracking-widest uppercase mb-2 md:mb-3"
      >
        Objetivos de Servicio
      </h3>
      <h2
        class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-4 md:mb-6 leading-tight"
      >
        Nuestras Soluciones Tecnológicas
      </h2>
      <p class="text-slate-500 text-base md:text-lg leading-relaxed px-2">
        Soluciones corporativas diseñadas para escalar su negocio con precisión
        y eficiencia.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
      {
        solutions.map((item) => (
          <div class="group bg-white border border-slate-100 p-6 md:p-8 rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col items-center text-center">
            <div class="w-16 h-16 md:w-20 md:h-20 rounded-2xl flex items-center justify-center mb-6 md:mb-8 transition-colors duration-300 bg-[#2499D6]/10 text-[#2499D6] group-hover:bg-[#2499D6] group-hover:text-white shrink-0">
              {item.icon === "inventory" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-8 h-8 md:w-10 md:h-10"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
                  />
                </svg>
              )}
              {item.icon === "web" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-8 h-8 md:w-10 md:h-10"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
                  />
                </svg>
              )}
              {item.icon === "consulting" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-8 h-8 md:w-10 md:h-10"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  />
                </svg>
              )}
            </div>

            <h4 class="text-xl font-bold text-slate-900 mb-3 md:mb-4">
              {item.title}
            </h4>
            <p class="text-slate-600 mb-6 md:mb-8 leading-relaxed flex-grow text-sm md:text-base">
              {item.description}
            </p>

            <a
              href={item.link}
              class="w-full bg-[#2499D6] hover:bg-[#1d82b8] text-white py-3 md:py-3.5 rounded-lg font-bold text-sm transition-all shadow-md shadow-blue-200 active:scale-95"
            >
              {item.buttonText}
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>
