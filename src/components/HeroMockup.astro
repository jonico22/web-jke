---
// src/components/HeroMockup.astro
---

<div
  class="w-full aspect-[4/3] bg-white rounded-xl shadow-2xl border border-slate-200 overflow-hidden flex flex-col mx-auto"
>
  <div
    class="bg-slate-50 border-b border-slate-200 px-4 py-3 flex items-center justify-between"
  >
    <div class="flex gap-1.5">
      <div class="w-3 h-3 rounded-full bg-red-400"></div>
      <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
      <div class="w-3 h-3 rounded-full bg-green-400"></div>
    </div>
    <div class="w-32 h-2 bg-slate-200 rounded-full"></div>
    <div class="w-4 h-4 bg-slate-200 rounded-full"></div>
  </div>

  <div class="flex-1 flex p-4 gap-4">
    <div class="w-1/4 space-y-3 hidden sm:block">
      <div class="h-8 bg-slate-100 rounded-md w-full"></div>
      <div class="h-4 bg-slate-50 rounded-md w-3/4"></div>
      <div class="h-4 bg-slate-50 rounded-md w-1/2"></div>
      <div class="h-4 bg-slate-50 rounded-md w-5/6"></div>
    </div>

    <div class="flex-1 space-y-4">
      <div class="flex justify-between items-center">
        <div class="h-6 bg-slate-100 rounded-md w-1/3"></div>
        <button
          class="bg-primary text-[10px] text-white px-3 py-1.5 rounded-md font-bold shadow-sm"
        >
          Nueva Venta
        </button>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div
          class="h-16 bg-blue-50 border border-blue-100 rounded-lg flex items-center justify-center"
        >
          <div class="w-8 h-8 bg-blue-200 rounded-md"></div>
        </div>
        <div
          class="h-16 bg-green-50 border border-green-100 rounded-lg flex items-center justify-center"
        >
          <div class="w-8 h-8 bg-green-200 rounded-md"></div>
        </div>
      </div>

      <div
        class="flex-1 bg-slate-50 border border-slate-100 rounded-lg p-4 flex flex-col items-center justify-center"
      >
        <p
          class="text-[10px] text-slate-400 font-medium mb-2 uppercase tracking-wider"
        >
          Gráfico de Rendimiento
        </p>
        <div class="w-full h-24 flex items-end gap-1 px-2">
          <div class="flex-1 bg-slate-200 rounded-t h-[40%]"></div>
          <div class="flex-1 bg-primary/40 rounded-t h-[60%]"></div>
          <div class="flex-1 bg-slate-200 rounded-t h-[30%]"></div>
          <div class="flex-1 bg-primary rounded-t h-[80%]"></div>
          <div class="flex-1 bg-slate-200 rounded-t h-[50%]"></div>
        </div>
      </div>
    </div>
  </div>
</div>
